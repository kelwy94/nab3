rules_version = '2';

// Uploads: avatars, product/equipment/crop/land images, consultation voice
// notes, and private land ownership documents.
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function registered() {
      return signedIn()
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function isAdmin() {
      return registered()
        && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role
             in ['UserRole.admin', 'admin'];
    }

    // Uploads only ever add new files; existing files can't be overwritten.
    function newFile() {
      return resource == null;
    }

    function validUpload() {
      return request.resource.size < 10 * 1024 * 1024
        && (request.resource.contentType.matches('image/.*')
            || request.resource.contentType.matches('audio/.*'));
    }

    // Each user can only replace their own avatar.
    match /avatars/{fileName} {
      allow read: if signedIn();
      allow write: if registered()
        && fileName.matches(request.auth.uid + '\\..*')
        && validUpload();
    }

    match /voice_notes/{fileName} {
      allow read: if signedIn();
      allow create: if registered() && newFile() && validUpload();
    }

    // Product, equipment and land photos are shown to guests in the markets.
    match /equipment_images/{allPaths=**} {
      allow read: if signedIn();
      allow create: if registered() && newFile() && validUpload();
    }

    match /products/{allPaths=**} {
      allow read: if signedIn();
      allow create: if registered() && newFile() && validUpload();
    }

    match /land_listings/{allPaths=**} {
      allow read: if signedIn();
      allow create: if registered() && newFile() && validUpload();
    }

    // Land ownership documents are private to the uploader and admins.
    match /land_docs/{ownerId}/{allPaths=**} {
      allow read: if (registered() && request.auth.uid == ownerId) || isAdmin();
      allow create: if registered() && request.auth.uid == ownerId && newFile() && validUpload();
    }
  }
}
